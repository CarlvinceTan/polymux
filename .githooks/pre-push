#!/bin/sh

while read -r local_ref local_sha remote_ref remote_sha; do
	case "$local_sha:$remote_ref" in
		0000000000000000000000000000000000000000:refs/heads/main|0000000000000000000000000000000000000000:refs/heads/dev)
			echo "Push blocked: permanent branches cannot be deleted." >&2
			exit 1
			;;
		0000000000000000000000000000000000000000:refs/heads/*)
			continue
			;;
	esac
	if [ "$remote_ref" != "refs/heads/dev" ]; then
		echo "Push blocked: only dev may be pushed from this checkout." >&2
		echo "Promote dev to main through the reviewed merge queue." >&2
    exit 1
  fi
done

exit 0

# Tailnet IP:port for the API listener (or loopback with POLYMUX_DEV=1).
POLYMUX_LISTEN=
# Set to 1 to allow an explicit loopback listener.
POLYMUX_DEV=
# Server data directory (defaults under Application Support when empty).
POLYMUX_DATA_DIR=
# Path to a JSON file of agent definitions that overrides the built-in set.
POLYMUX_AGENTS=
# Path to the media-text extractor binary for search indexing.
POLYMUX_EXTRACTOR=
# Path to a llama.cpp embedding server binary for local semantic search.
POLYMUX_LLAMA=
# GGUF model path for POLYMUX_LLAMA (empty uses the binary default).
POLYMUX_EMBED_MODEL=
# Multimodal projector GGUF for POLYMUX_LLAMA. Setting it embeds image and audio
# attachments as media; it needs a multimodal model, so leave it empty with the
# text-only default model. Video is not supported.
POLYMUX_EMBED_MMPROJ=
# Remote embedding HTTP endpoint when not using POLYMUX_LLAMA. Text only.
POLYMUX_EMBED_URL=
# Absolute path to the APNs .p8 auth key for push notifications.
POLYMUX_APNS_KEY_FILE=
# APNs key ID paired with POLYMUX_APNS_KEY_FILE.
POLYMUX_APNS_KEY_ID=
# Apple Developer Team ID for APNs.
POLYMUX_APNS_TEAM_ID=
# Override the model provider base URL from model.json.
POLYMUX_MODEL_URL=
# Override the model name from model.json.
POLYMUX_MODEL=
# Model API credential (preferred over keyEnv / keyFile in model.json).
POLYMUX_MODEL_KEY=

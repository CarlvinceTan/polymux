{
  "name": "@polymux/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/registry.ts",
    "build": "vite build",
    "vercel-build": "node scripts/api.ts",
    "check": "node scripts/prepare.ts && svelte-check --tsconfig ./tsconfig.json",
    "test": "node scripts/prepare.ts && node --test test/*.test.js",
    "test:responsive": "node --test test/responsive.js",
    "verify": "npm test && npm run check && npm run build",
    "preview": "vite preview"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "//typescript": "Stay on 6.x until svelte-check accepts TypeScript 7.",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "dompurify": "^3.4.17",
    "marked": "^18.2.0",
    "simple-icons": "^16.37.0",
    "yaml": "^2.9.1"
  }
}

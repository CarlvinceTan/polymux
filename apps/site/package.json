{
  "name": "@polymux/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/registry.ts",
    "build": "vite build",
    "vercel-build": "node scripts/api.ts",
    "check": "node scripts/prepare.ts && svelte-check --tsconfig ./tsconfig.json",
    "test": "node scripts/prepare.ts && node --test test/*.test.js",
    "test:responsive": "node --test test/responsive.js",
    "verify": "npm test && npm run check && npm run build",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "svelte": "^5.46.4",
    "svelte-check": "^4.4.8",
    "tslib": "^2.6.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.5"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "simple-icons": "^16.28.0",
    "yaml": "^2.9.0"
  }
}

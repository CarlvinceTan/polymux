{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "target": "ESNext",
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "lib/**/*.ts",
    "api/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts"
  ]
}

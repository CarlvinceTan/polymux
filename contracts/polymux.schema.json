{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymux.local/contracts/v1",
  "title": "Polymux wire contract",
  "$defs": {
    "PushStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registered": {
          "type": "boolean"
        },
        "available": {
          "type": "boolean"
        }
      },
      "required": [
        "registered",
        "available"
      ]
    },
    "Notice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "seq": {
          "type": "integer"
        },
        "conversationID": {
          "type": "string"
        },
        "messageID": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "body",
        "outcome",
        "seq",
        "conversationID",
        "messageID",
        "title",
        "createdAt"
      ]
    },
    "NoticePage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": "integer"
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Notice"
          }
        }
      },
      "required": [
        "cursor",
        "notices"
      ]
    },
    "PushDevice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "server": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "token",
        "environment",
        "server",
        "enabled"
      ]
    },
    "HostState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "running": {
          "type": "boolean"
        },
        "pid": {
          "type": "integer"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "running",
        "pid",
        "error"
      ]
    },
    "HostPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "Settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer"
        },
        "appearance": {
          "type": "string"
        },
        "sidebarWidth": {
          "type": "number"
        },
        "voiceMode": {
          "type": "string"
        },
        "liveProvider": {
          "type": "string"
        },
        "liveModel": {
          "type": "string"
        },
        "liveVoice": {
          "type": "string"
        },
        "textProvider": {
          "type": "string"
        },
        "textModel": {
          "type": "string"
        },
        "voicePrompt": {
          "type": "string"
        },
        "speechKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "revision",
        "appearance",
        "sidebarWidth",
        "voiceMode",
        "liveProvider",
        "liveModel",
        "liveVoice",
        "textProvider",
        "textModel",
        "voicePrompt",
        "speechKeys"
      ]
    },
    "SettingsPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appearance": {
          "type": "string"
        },
        "sidebarWidth": {
          "type": "number"
        },
        "voiceMode": {
          "type": "string"
        },
        "liveProvider": {
          "type": "string"
        },
        "liveModel": {
          "type": "string"
        },
        "liveVoice": {
          "type": "string"
        },
        "textProvider": {
          "type": "string"
        },
        "textModel": {
          "type": "string"
        },
        "voicePrompt": {
          "type": "string"
        }
      },
      "required": []
    },
    "SpeechKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        }
      },
      "required": [
        "key"
      ]
    },
    "Agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "avatar": {
          "$ref": "#/$defs/AvatarDesign"
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "model",
        "active"
      ]
    },
    "Thread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leadAgentID": {
          "type": "string"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Run"
          }
        },
        "id": {
          "type": "string"
        },
        "agentID": {
          "type": "string"
        },
        "lastReadSeq": {
          "type": "integer",
          "minimum": 0
        },
        "lastSeq": {
          "type": "integer",
          "minimum": 0
        },
        "unreadCount": {
          "type": "integer",
          "minimum": 0
        },
        "lastMessage": {
          "$ref": "#/$defs/Message"
        },
        "title": {
          "type": "string"
        },
        "agentIDs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "pinned": {
          "type": "boolean"
        },
        "pinOrder": {
          "type": "number",
          "minimum": 0
        },
        "sectionID": {
          "type": "string"
        },
        "sectionOrder": {
          "type": "number"
        }
      },
      "required": [
        "runs",
        "id",
        "agentID",
        "lastReadSeq",
        "lastSeq",
        "unreadCount",
        "title",
        "agentIDs"
      ]
    },
    "Attachment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "image",
            "video",
            "audio",
            "html",
            "file"
          ]
        },
        "name": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string"
        },
        "thumbnailURL": {
          "type": "string"
        },
        "extractedText": {
          "type": "string"
        },
        "indexingState": {
          "type": "string",
          "enum": [
            "pending",
            "ready",
            "error"
          ]
        },
        "width": {
          "type": "number",
          "minimum": 44,
          "maximum": 550,
          "description": "Requested HTML viewport width in logical CSS pixels; constrained by the native available width."
        },
        "height": {
          "type": "number",
          "minimum": 44,
          "maximum": 400,
          "description": "Requested HTML viewport height in logical CSS pixels; omitted for measured content height."
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "mimeType",
        "size",
        "url",
        "indexingState"
      ]
    },
    "Part": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "attachment",
            "tool",
            "choice"
          ]
        },
        "text": {
          "type": "string"
        },
        "attachment": {
          "$ref": "#/$defs/Attachment"
        },
        "name": {
          "type": "string"
        },
        "args": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChoiceOption"
          }
        },
        "answerID": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "ReplyContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "messageID": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant",
            "system"
          ]
        },
        "text": {
          "type": "string"
        },
        "attachment": {
          "$ref": "#/$defs/Attachment"
        },
        "agentID": {
          "type": "string"
        },
        "partIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "The selected text or attachment index in the original message Parts; absent for a whole-message quote."
        }
      },
      "required": [
        "messageID",
        "role",
        "text"
      ]
    },
    "Message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runID": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "threadID": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant",
            "system"
          ]
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "streaming",
            "done",
            "error"
          ]
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Immutable sequence of the message.start event; 0 only for an optimistic unsent client message."
        },
        "replyToID": {
          "type": "string",
          "description": "The user message ID that triggered this assistant reply; used to correlate queued voice turns."
        },
        "reply": {
          "$ref": "#/$defs/ReplyContext",
          "description": "A durable snapshot of the message quoted by this user message."
        },
        "agentID": {
          "type": "string",
          "description": "The assistant member that authored this message."
        },
        "mentions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Explicit member IDs addressed by this user message."
        }
      },
      "required": [
        "id",
        "threadID",
        "role",
        "parts",
        "createdAt",
        "status",
        "seq"
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing durable replay cursor scoped to conversationID."
        },
        "conversationID": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "message.start",
            "message.delta",
            "message.tool_call",
            "message.attachment",
            "message.error",
            "message.done",
            "agent.presence",
            "run.start",
            "run.update",
            "run.done",
            "tool.start",
            "tool.update",
            "tool.done",
            "peer.delivery",
            "group.handoff",
            "approval_requested"
          ]
        },
        "messageID": {
          "type": "string"
        },
        "agentID": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/Message"
        },
        "attachment": {
          "$ref": "#/$defs/Attachment"
        },
        "active": {
          "type": "boolean"
        },
        "error": {
          "$ref": "#/$defs/Error"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "runID": {
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/Run"
        },
        "tool": {
          "$ref": "#/$defs/ToolActivity"
        },
        "delivery": {
          "$ref": "#/$defs/PeerDelivery"
        },
        "routineID": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "approval": {
          "$ref": "#/$defs/ApprovalRequest"
        }
      },
      "required": [
        "seq",
        "conversationID",
        "type",
        "createdAt"
      ]
    },
    "ApprovalRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "runID": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "args": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "runID",
        "tool",
        "args",
        "expiresAt"
      ]
    },
    "Usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "inputTokens",
        "outputTokens"
      ]
    },
    "SendRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "attachmentIDs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replyToID": {
          "type": "string",
          "description": "An optional existing message in the same conversation to quote in this message."
        },
        "replyPart": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional source Parts index to quote one text or attachment; requires replyToID."
        },
        "mentions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "description": "Optional explicit mention IDs; only conversation members are woken."
        }
      },
      "required": [
        "id",
        "text",
        "attachmentIDs"
      ]
    },
    "ReadRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "seq"
      ]
    },
    "SearchHit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {
          "$ref": "#/$defs/Message"
        },
        "score": {
          "type": "number"
        },
        "snippet": {
          "type": "string"
        },
        "indexingState": {
          "type": "string",
          "enum": [
            "pending",
            "ready",
            "error"
          ]
        }
      },
      "required": [
        "message",
        "score",
        "snippet"
      ]
    },
    "Routine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "nextAt": {
          "type": "string",
          "format": "date-time"
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "active",
            "cancelled",
            "finished"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "id": {
          "type": "string"
        },
        "agentID": {
          "type": "string"
        },
        "trigger": {
          "type": "string",
          "enum": [
            "once",
            "interval"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "timezone": {
          "type": "string",
          "maxLength": 64,
          "description": "IANA zone for a wall-clock recurrence; empty means fixed elapsed intervals"
        }
      },
      "required": [
        "at",
        "intervalSeconds",
        "status",
        "createdAt",
        "id",
        "agentID",
        "trigger",
        "prompt"
      ]
    },
    "RoutineRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "timezone": {
          "type": "string",
          "maxLength": 64,
          "description": "IANA zone for a wall-clock recurrence; empty means fixed elapsed intervals"
        }
      },
      "required": [
        "prompt",
        "at",
        "intervalSeconds"
      ]
    },
    "Proactivity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 3600,
          "maximum": 604800
        },
        "nextAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "enabled",
        "intervalSeconds"
      ]
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jobID": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "conversationID": {
          "type": "string"
        },
        "trigger": {
          "type": "string",
          "enum": [
            "message",
            "created",
            "peer",
            "handoff",
            "routine",
            "review",
            "follow_up",
            "task",
            "event"
          ]
        },
        "taskID": {
          "type": "string"
        },
        "sourceMessageID": {
          "type": "string"
        },
        "parentRunID": {
          "type": "string"
        },
        "routineID": {
          "type": "string"
        },
        "messageID": {
          "type": "string"
        },
        "toolID": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolActivity"
          }
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "activity": {
          "type": "string",
          "enum": [
            "preparing",
            "generating",
            "tool",
            "rendering",
            "handoff",
            ""
          ]
        },
        "outcome": {
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/Error"
        },
        "agentID": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "waiting_input",
            "waiting_peer",
            "completed",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "jobID",
        "id",
        "agentID",
        "conversationID",
        "trigger",
        "status",
        "activity",
        "attempt",
        "seq",
        "createdAt",
        "updatedAt",
        "summary"
      ]
    },
    "ToolActivity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "runID": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "summary": {
          "type": "string"
        },
        "output": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "runID",
        "name",
        "status"
      ]
    },
    "PeerDelivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "sourceAgentID": {
          "type": "string"
        },
        "targetAgentID": {
          "type": "string"
        },
        "conversationID": {
          "type": "string"
        },
        "parentRunID": {
          "type": "string"
        },
        "runID": {
          "type": "string"
        },
        "intent": {
          "type": "string",
          "enum": [
            "request",
            "question",
            "result",
            "status",
            "handoff"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "delivered",
            "completed",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "sourceAgentID",
        "targetAgentID",
        "conversationID",
        "parentRunID",
        "intent",
        "status",
        "createdAt"
      ]
    },
    "ChoiceOption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "FocusAnswer": {
      "type": "object",
      "additionalProperties": false,

  "x-http": {
    "GET /agents": {
      "response": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Agent"
        }
      }
    },
    "GET /threads": {
      "response": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Thread"
        }
      }
    },
    "GET /threads/{id}/messages": {
      "query": {
        "before": "exclusive message seq cursor",
        "limit": "page size, default 100"
      },
      "response": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Message"
        }
      }
    },
    "GET /threads/{id}/events": {
      "query": {
        "after": "exclusive durable event seq, default 0",
        "limit": "page size, default 100, maximum 1000; keep fetching after last received seq until an empty page"
      },
      "response": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Event"
        }
      },
      "order": "ascending seq; event cursors are scoped to a conversation"
    },
    "GET /threads/{id}/stream": {
      "query": {
        "after": "exclusive durable event seq, default 0"
      },
      "response": "text/event-stream; each data field is one Event JSON; replay before live delivery"
    },
    "POST /threads/{id}/messages": {
      "request": {
        "$ref": "#/$defs/SendRequest"
      },
      "idempotency": "SendRequest.id is the client message identity; retries return the original accepted message without another agent turn"
    },
    "POST /threads/{id}/voice": {
      "request": {
        "$ref": "#/$defs/VoiceRequest"
      },
      "response": {
        "$ref": "#/$defs/VoiceResponse"
      },
      "privacy": "Private agent consultation, never accepted into typed chat or indexed. Only explicit send_to_user/show_html publications become messages.",
      "cancellation": "Request disconnect cancels only this private task. No automatic replay; duplicate IDs are refused for the server lifetime."
    },
    "POST /threads/{id}/read": {
      "request": {
        "$ref": "#/$defs/ReadRequest"
      }
    },
    "POST /threads/{id}/stop": {
      "request": {
        "type": "object"
      }
    },
    "GET /threads/{id}/search": {
      "query": {
        "q": "query text, current conversation only"
      },
      "response": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/SearchHit"
        }
      }
    },
    "POST /attachments": {
      "request": "multipart/form-data; file field",
      "response": {
        "$ref": "#/$defs/Attachment"
      }
    },
    "POST /agents": {
      "request": {
        "$ref": "#/$defs/CreateAgentRequest"
      },
      "response": {
        "$ref": "#/$defs/Agent"
      },
      "status": 201
    },
    "GET /agents/{id}": {
      "response": {
        "$ref": "#/$defs/AgentProfile"
      }
    },
    "PATCH /agents/{id}": {
      "request": {
        "$ref": "#/$defs/UpdateAgentRequest"
      },
      "response": {
        "$ref": "#/$defs/AgentProfile"
      }
    },
    "PATCH /agents/{id}/avatar": {
      "request": {
        "$ref": "#/$defs/AvatarDesign"
      },
      "response": {
        "$ref": "#/$defs/Agent"
      }
    },
    "DELETE /agents/{id}": {
      "response": {
        "$ref": "#/$defs/DeleteResponse"
      },
      "status": 200,
      "idempotency": "Deleting an already deleted identity returns deleted=true without recreating it."
    },
    "POST /threads": {
      "request": {
        "$ref": "#/$defs/CreateThreadRequest"
      },
      "response": {
        "$ref": "#/$defs/Thread"
      },
      "status": 201
    },
    "PATCH /threads/{id}": {
      "request": {
        "$ref": "#/$defs/UpdateThreadRequest"
      },
      "response": {
        "$ref": "#/$defs/Thread"
      }
    },
    "POST /agents/{id}/focus": {
      "request": null,
      "response": {
        "$ref": "#/$defs/FocusStatus"
      },
      "note": "post the deterministic first-run card once, while the conversation has no user turn"
    },
    "POST /agents/{id}/focus/answer": {
      "request": {
        "$ref": "#/$defs/FocusAnswer"
      },
      "response": {
        "$ref": "#/$defs/FocusStatus"
      },
      "note": "record the chosen first-run option and post its deterministic acknowledgment"
    }
  }
}
